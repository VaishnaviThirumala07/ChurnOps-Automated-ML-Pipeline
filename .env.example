# ── Copy this file to .env and fill in your values ──────────────────────────
# NEVER commit the real .env to git (it's already in .gitignore)

# MLflow Tracking Server (e.g. DagsHub free tier)
# DagsHub: https://dagshub.com/  → create repo → MLflow tab → copy URI
MLFLOW_TRACKING_URI=https://<dagshub-user>:<dagshub-token>@dagshub.com/<user>/<repo>.mlflow

# GitHub Automation (for drift-triggered retraining)
# Generate at: https://github.com/settings/tokens  (needs repo scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_REPO=your-username/DS_Project1

# Prometheus (for drift trigger service)
PROMETHEUS_URL=http://localhost:9090
DRIFT_THRESHOLD=0.5
CHECK_INTERVAL_SECONDS=60

# Docker (optional — for CI push to DockerHub)
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-token

# DagsHub token (for DVC remote pull in CI)
DAGSHUB_USER_TOKEN=your-dagshub-personal-access-token
